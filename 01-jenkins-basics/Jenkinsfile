pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/pasinduweerarathne/jenkins-course.git', branch: 'jenkins-basics'
                bat "dir"
            }
        }

        stage('Setup') {
            steps {
                bat "pip install -r requirements.txt"
            }
        }

        stage('Test') {
            steps {
                bat "pytest"
            }
        }
    }
}


